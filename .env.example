# URL pública do projeto, sem barra no final
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gere com: openssl rand -base64 32
AUTH_SECRET=

# Gere com: npm run hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=

# Upstash Redis, disponível pelo Marketplace da Vercel
PN_KV_REST_API_READ_ONLY_TOKEN=
PN_KV_REST_API_TOKEN=
PN_KV_REST_API_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob para upload de capas, imagens dos artigos e comentários
BLOB_READ_WRITE_TOKEN=

# Moderação de texto e imagens dos comentários via Sightengine
SIGHT_ENGINE_API_USER=
SIGHT_ENGINE_API_KEY=

# Tempo real via UDP (geckos.io) ou sondagem HTTP. Sem variáveis de jogo
# configuradas, tudo funciona em HTTP automaticamente.

# Servidor UDP das partidas (Render + geckos.io). Quando o usuário entra na
# aba de games, o site chama /api/games/wake para acordar o serviço.
# Sem estas variáveis, o jogo usa sondagem HTTP automaticamente.
NEXT_PUBLIC_GAME_SERVER_URL=
GAME_SERVER_URL=
NEXT_PUBLIC_USE_PHASER=

# Redis TCP do servidor de partidas (game-server no Render). Não é o Upstash
# REST do site: este vai no dashboard do Render como REDIS_URL.
REDIS_URL=
