# URL pública do projeto, sem barra no final
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gere com: openssl rand -base64 32
AUTH_SECRET=

# Gere com: npm run hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=

# Upstash Redis, disponível pelo Marketplace da Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternativas reconhecidas automaticamente pela integração KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob para upload de capas e imagens dos artigos
BLOB_READ_WRITE_TOKEN=
