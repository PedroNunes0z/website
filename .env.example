# URL pública do projeto, sem barra no final
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gere com: openssl rand -base64 32
AUTH_SECRET=

# Gere com: npm run hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=

# Upstash Redis, disponível pelo Marketplace da Vercel
PN_KV_REST_API_READ_ONLY_TOKEN=
PN_KV_REST_API_TOKEN=
PN_KV_REST_API_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob para upload de capas, imagens dos artigos e comentários
BLOB_READ_WRITE_TOKEN=

# Moderação de texto e imagens dos comentários via Sightengine
SIGHT_ENGINE_API_USER=
SIGHT_ENGINE_API_KEY=

# Tempo real das salas multiplayer (chave restrita ao recurso game-room:*).
# Apenas no servidor: nunca exponha no navegador. Sem a chave, o jogo usa
# o fallback HTTP automaticamente. NEXT_PUBLIC_ABLY_CLIENT_ID não é
# necessária: o clientId é embutido no token emitido pelo servidor.
ABLY_API_KEY=
